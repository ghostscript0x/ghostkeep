# --- Postgres (CasaOS) ---
DATABASE_URL=
# --- Redis (CasaOS, no password) ---
REDIS_URL=redis://192.168.1.103:6379
# --- SMTP (email verification + password resets; leave empty for dev-token mode) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@ghostkeep.local
# --- Auth ---
SESSION_SECRET=change-me-32-bytes-min
# 32-byte base64 master keys (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))" — use DIFFERENT keys per entry, never commit real keys)
RECOVERY_MASTER_KEY_ID=v1
RECOVERY_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
SESSION_CRED_MASTER_KEY_ID=v1
SESSION_CRED_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# --- App ---
PORT=4000
WEB_URL=http://localhost:3000
NODE_ENV=development
# Baileys (pinned; 6.7.8+ has a spoofing advisory — stay on 6.7.22+)
BAILEYS_VERSION=6.7.22
# Transient message cache (Redis + in-memory fallback)
MSG_CACHE_MAX=1000
MSG_CACHE_TTL_MS=900000
# Retention (default 30 days)
RECOVERY_RETENTION_DAYS=30
# Admin bootstrap (first admin, then remove)
BOOTSTRAP_ADMIN_EMAIL=
# WhatsApp socket log level
WA_LOG_LEVEL=warn
