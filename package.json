{
  "name": "ghostkeep",
  "private": true,
  "workspaces": [
    "backend",
    "web"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "dev:backend": "npm run dev -w backend",
    "dev:web": "npm run dev -w web",
    "dev:all": "concurrently -n api,web -c green,cyan \"npm run dev:backend\" \"npm run dev:web\""
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
